import Mathlib.Tactic
import Axioms

/-!
# CollatzBridge: Standard ↔ Compressed Collatz

This module proves the relationship between standard collatz and compressed T,
allowing us to eliminate the bridge axioms.

## Key Insight

- Standard collatz: even → n/2, odd → 3n+1
- Compressed T: even → n/2, odd → (3n+1)/2

For odd n, T(n) = collatz(collatz(n)), so T "advances faster".
If standard collatz descends, compressed T must also descend.
-/

namespace CollatzBridge

open Axioms

/-!
## Part 1: Basic Relationships
-/

-- T and collatz agree on even inputs
lemma T_eq_collatz_even (n : ℕ) (heven : n % 2 = 0) : T n = collatz n := by
  simp only [T, collatz, heven, ↓reduceIte]

-- For odd n, T(n) = collatz(collatz(n))
lemma T_eq_collatz_collatz_odd (n : ℕ) (hodd : n % 2 = 1) : T n = collatz (collatz n) := by
  simp only [T, collatz]
  have h : ¬(n % 2 = 0) := by omega
  simp only [h, ↓reduceIte]
  -- collatz n = 3n+1, which is even, so collatz(collatz n) = (3n+1)/2
  have heven : (3 * n + 1) % 2 = 0 := by omega
  simp only [heven, ↓reduceIte]

-- collatz output on odd input is always even
lemma collatz_odd_is_even (n : ℕ) (hodd : n % 2 = 1) : (collatz n) % 2 = 0 := by
  simp only [collatz]
  have h : ¬(n % 2 = 0) := by omega
  simp only [h, ↓reduceIte]
  omega

/-!
## Part 2: Trajectory Relationships

We show that the T trajectory is "ahead" of the collatz trajectory.
-/

-- Define trajectory using T (matching MersenneProofs)
def trajectoryT (n : ℕ) : ℕ → ℕ
  | 0 => n
  | k + 1 => T (trajectoryT n k)

-- The key lemma: if collatz trajectory visits m < n, so does T trajectory
-- Actually, we prove: trajectoryDescends implies drops using T

/-!
## Part 3: Descent Transfer

The bridge theorem: if standard collatz descends, drops holds.
-/

-- First, unpack what trajectoryDescends means
lemma trajectoryDescends_means (n k : ℕ) :
    trajectoryDescends n k = true ↔
    ∃ j, j < k ∧ 0 < trajectory n (j + 1) ∧ trajectory n (j + 1) < n := by
