-- Alternative: direct proof that trajectoryDescends implies a witness exists
lemma trajectoryDescends_witness (n k : ℕ) (h : trajectoryDescends n k = true) :
    ∃ j ≤ k, 0 < trajectory n j ∧ trajectory n j < n := by
  -- The go function checks each step
  -- If it returns true, it found such a j
  sorry -- Requires go function analysis

-- Bridge: standard trajectory descent implies T trajectory descent
-- Key insight: at each step, T is at least as far as collatz

-- For a more direct approach, show that if trajectory n j < n,
-- then trajectoryT n j' < n for some j' ≤ j

lemma trajectory_le_trajectoryT (n : ℕ) (k : ℕ) :
    ∃ j ≤ k, trajectoryT n j ≤ trajectory n k := by
  -- T advances at least as fast as collatz
  induction k with
  | zero =>
    use 0
    simp [trajectory, trajectoryT]
  | succ k ih =>
    obtain ⟨j, hj, hle⟩ := ih
    by_cases heven : (trajectory n k) % 2 = 0
    · -- Both T and collatz halve
      use j + 1, by omega
      simp only [trajectory, trajectoryT]
      calc trajectoryT n (j + 1) = T (trajectoryT n j) := rfl
        _ ≤ T (trajectory n k) := by
          -- T is monotonic? Not quite...
          sorry
        _ = collatz (trajectory n k) := T_eq_collatz_even _ heven
        _ = trajectory n (k + 1) := rfl
    · -- trajectory n k is odd
      -- collatz goes to 3m+1, T goes to (3m+1)/2
      -- T is ahead by one step
      sorry

