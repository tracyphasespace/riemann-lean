/-! ### Aggregate Bridge Infrastructure -/

/-- Pointwise ≤ implies foldl ≤ (with possibly different starting accumulators). -/
private lemma foldl_add_le {l : List α} {f g : α → ℝ} {a₁ a₂ : ℝ}
    (ha : a₁ ≤ a₂) (h : ∀ x ∈ l, f x ≤ g x) :
    l.foldl (fun acc x => acc + f x) a₁ ≤ l.foldl (fun acc x => acc + g x) a₂ := by
  induction l generalizing a₁ a₂ with
  | nil => exact ha
  | cons x xs ih =>
    simp only [List.foldl_cons]
    exact ih (by linarith [h x (by simp)])
      (fun y hy => h y (by simp [hy]))

/-- Foldl over tuples projecting first component equals foldl over the projected list. -/
private lemma foldl_proj_eq {l : List (ℕ × ℤ × Bool)} {f : ℕ → ℝ} {a : ℝ} :
    l.foldl (fun (acc : ℝ) (x : ℕ × ℤ × Bool) => acc + f x.1) a =
    (l.map Prod.fst).foldl (fun (acc : ℝ) x => acc + f x) a := by
  induction l generalizing a with
  | nil => rfl
  | cons x xs ih => simp only [List.foldl_cons, List.map_cons]; exact ih

/-- ℚ→ℝ cast commutes with foldl over addition (generalized). -/
private lemma foldl_add_cast {l : List α} {f : α → ℚ} {a : ℚ} :
    l.foldl (fun (acc : ℝ) (x : α) => acc + ↑(f x)) (↑a : ℝ) =
    ↑(l.foldl (fun (acc : ℚ) (x : α) => acc + f x) a) := by
  induction l generalizing a with
  | nil => rfl
  | cons x xs ih =>
    simp only [List.foldl_cons]
    rw [show (↑a : ℝ) + ↑(f x) = (↑(a + f x) : ℝ) from by push_cast; ring]
    exact ih

/-! ### Final Bridge Theorem -/

set_option maxHeartbeats 800000 in
/-- The rotor trace bound for primeList, connecting fullCheck to CliffordRH.rotorTrace. -/
theorem rotorTrace_primeList_lt :
    CliffordRH.rotorTrace (1 / 2) 14.134725 primeList < -5 := by
  unfold CliffordRH.rotorTrace
  rw [t_eq]
  -- Relate primeList.foldl to allTerms.foldl via allTerms_primes_eq
  rw [show primeList = allTerms.map Prod.fst from allTerms_primes_eq.symm]
  rw [← foldl_proj_eq]
  -- Each actual term ≤ the interval .hi (upper bound)
  -- Note: after unfolding rotorTrace, exponent is -(1/2); mkTermReduced_eval_eq uses (-1)/2
  have h_le : allTerms.foldl (fun (acc : ℝ) (x : ℕ × ℤ × Bool) =>
      acc + Real.log (x.1 : ℝ) * (x.1 : ℝ) ^ (-(1 / 2 : ℝ)) *
        Real.cos (565389 / 40000 * Real.log (x.1 : ℝ))) 0 ≤
    allTerms.foldl (fun (acc : ℝ) (x : ℕ × ℤ × Bool) =>
      acc + ↑(termIntervalReduced x.1 x.2.1 x.2.2 { taylorDepth := 30 }).hi) 0 := by
    apply foldl_add_le (le_refl _)
    intro ⟨p, k, neg⟩ hx
    have h_neg := (List.forall_iff_forall_mem.mp allTerms_neg_correct) _ hx
    have h_dom := (List.forall_iff_forall_mem.mp allTerms_domain_valid) _ hx
    have h_pos := (List.forall_iff_forall_mem.mp allTerms_pos) _ hx
    have hp : 0 < (p : ℝ) := Nat.cast_pos.mpr h_pos
    calc Real.log (p : ℝ) * (p : ℝ) ^ (-(1 / 2 : ℝ)) *
          Real.cos (565389 / 40000 * Real.log (p : ℝ))
        = Real.log (p : ℝ) * (p : ℝ) ^ ((-1 : ℝ) / 2) *
          Real.cos (565389 / 40000 * Real.log (p : ℝ)) := by
          congr 2; congr 1; ring
      _ = Expr.eval (fun _ => (0 : ℝ)) (mkRotorTermReduced p k neg) :=
          (mkTermReduced_eval_eq p hp k neg h_neg).symm
      _ ≤ ↑(termIntervalReduced p k neg { taylorDepth := 30 }).hi :=
          termReduced_le_hi p k neg _ (checkDomainValid1_correct _ _ _ h_dom)
  -- Cast ℚ foldl to ℝ and use fullCheck bound
  have h_cast : allTerms.foldl (fun (acc : ℝ) (x : ℕ × ℤ × Bool) =>
      acc + ↑(termIntervalReduced x.1 x.2.1 x.2.2 { taylorDepth := 30 }).hi) 0 =
    ↑(allTerms.foldl (fun (acc : ℚ) (x : ℕ × ℤ × Bool) =>
      acc + (termIntervalReduced x.1 x.2.1 x.2.2 { taylorDepth := 30 }).hi) 0) := by
    rw [show (0 : ℝ) = (↑(0 : ℚ) : ℝ) from by simp]
    exact foldl_add_cast
  have h_bound : (2 : ℚ) * allTerms.foldl (fun (acc : ℚ) (x : ℕ × ℤ × Bool) =>
      acc + (termIntervalReduced x.1 x.2.1 x.2.2 { taylorDepth := 30 }).hi) 0 < -5 := by
    have hfc := fullCheck
    unfold rotorTraceCheckReduced at hfc
    simp only [decide_eq_true_eq] at hfc
    exact hfc
  -- Combine: actual ≤ cast(hiSum) and 2*hiSum < -5
  have h_cast_bound : (2 : ℝ) * ↑(allTerms.foldl (fun (acc : ℚ) (x : ℕ × ℤ × Bool) =>
      acc + (termIntervalReduced x.1 x.2.1 x.2.2 { taylorDepth := 30 }).hi) 0) < -5 := by
    exact_mod_cast h_bound
  linarith [h_le, h_cast, h_cast_bound]

/-! ### Permutation Bridge -/

/-- primeList is a permutation of (Nat.primesBelow 7920).toList. -/
private lemma primeList_perm_primesBelow :
    primeList.Perm (Nat.primesBelow 7920).toList :=
  List.perm_of_nodup_nodup_toFinset_eq primeList_nodup (Finset.nodup_toList _)
    (primeList_toFinset_eq.trans (Finset.toList_toFinset _).symm)

/-- rotorTrace is permutation-invariant (foldl over commutative addition). -/
private lemma rotorTrace_perm_eq {l₁ l₂ : List ℕ} (h : l₁.Perm l₂) (σ t : ℝ) :
    CliffordRH.rotorTrace σ t l₁ = CliffordRH.rotorTrace σ t l₂ := by
  unfold CliffordRH.rotorTrace
  congr 1
  have : RightCommutative (fun (acc : ℝ) (p : ℕ) =>
      acc + Real.log ↑p * (↑p) ^ (-σ) * Real.cos (t * Real.log ↑p)) :=
    ⟨fun a _ _ => by ring⟩
  exact h.foldl_eq 0

/-! ### The Final Theorem -/

/-- **Main result**: The rotor trace at the first zeta zero is less than -5.
    This eliminates `rotorTrace_first1000_lt_bound_axiom` from NumericalAxioms.lean. -/
theorem rotorTrace_primesBelow_lt :
    CliffordRH.rotorTrace (1 / 2) 14.134725 (Nat.primesBelow 7920).toList < -5 := by
  rw [← rotorTrace_perm_eq primeList_perm_primesBelow]
  exact rotorTrace_primeList_lt

end

