/-! ## Part 3: Certified Bound (ONE native_decide call) -/

/-- Cumulative bound checker: evaluate each term individually, sum upper bounds. -/
def rotorTraceCheckReduced
    (terms : List (ℕ × ℤ × Bool)) (bound : ℚ) (cfg : EvalConfig) : Bool :=
  let hiSum := terms.foldl (fun acc (p, k, neg) =>
    acc + (termIntervalReduced p k neg cfg).hi) (0 : ℚ)
  decide (2 * hiSum < bound)

set_option maxHeartbeats 40000000 in
set_option linter.style.nativeDecide false in
/-- The interval arithmetic verification: rotorTrace bound < -5.
    Uses taylorDepth 30 for high-precision transcendental evaluation. -/
theorem fullCheck :
    rotorTraceCheckReduced allTerms (-5) { taylorDepth := 30 } = true := by
  native_decide

/-! ## Part 4: Bridge Lemmas -/

noncomputable section
open Real

/-- ExprSupportedCore proof for mkRotorTermReduced — works for any parameters. -/
theorem mkRotorTermReduced_supported (p : ℚ) (k : ℤ) (neg : Bool) :
    ExprSupportedCore (mkRotorTermReduced p k neg) := by
  unfold mkRotorTermReduced
  cases neg <;> simp only [ite_true, ite_false, Bool.false_eq_true]
  · exact .mul (.mul (.log (.const p))
      (.exp (.neg (.mul (.log (.const p)) (.const (1/2))))))
      (.cos (.add (.mul (.const (565389/40000)) (.log (.const p)))
        (.neg (.mul (.const k) .pi))))
  · exact .mul (.mul (.log (.const p))
      (.exp (.neg (.mul (.log (.const p)) (.const (1/2))))))
      (.neg (.cos (.add (.mul (.const (565389/40000)) (.log (.const p)))
        (.neg (.mul (.const k) .pi)))))

/-- Per-term semantic bound: Expr.eval of mkRotorTermReduced gives an upper bound. -/
theorem termReduced_le_hi (p : ℕ) (k : ℤ) (neg : Bool) (cfg : EvalConfig)
    (hdom : evalDomainValid1 (mkRotorTermReduced p k neg) ⟨0, 0, le_refl _⟩ cfg) :
    Expr.eval (fun _ => (0 : ℝ)) (mkRotorTermReduced p k neg) ≤
    (termIntervalReduced p k neg cfg).hi := by
  have h := evalIntervalCore1_correct (mkRotorTermReduced p k neg)
    (mkRotorTermReduced_supported p k neg)
    0 ⟨0, 0, le_refl _⟩ (by simp [IntervalRat.mem_def]) cfg hdom
  exact h.2

/-! ### Atomic Bridge Lemmas -/

/-- 14.134725 equals 565389/40000 as real numbers. -/
private lemma t_eq : (14.134725 : ℝ) = (565389 : ℝ) / 40000 := by norm_num

/-- exp(-log(p) * (1/2)) = p^(-1/2) for p > 0 (bridges LeanCert Expr to rpow). -/
private lemma exp_neg_half_log (p : ℕ) (hp : 0 < (p : ℝ)) :
    Real.exp (-(Real.log (p : ℝ) * ((1 / 2 : ℚ) : ℝ))) = (p : ℝ) ^ (-(1 : ℝ) / 2) := by
  rw [rpow_def_of_pos hp]; congr 1; push_cast; ring

/-- Signed cosine after range reduction equals the original cosine.
    Uses cos(θ - k*π) = (-1)^k * cos(θ) from Mathlib. -/
private lemma signed_cos_eq (θ : ℝ) (k : ℤ) (neg : Bool) (hneg : neg = decide (k % 2 = 1)) :
    (if neg then -(Real.cos (θ - ↑k * Real.pi)) else Real.cos (θ - ↑k * Real.pi)) =
    Real.cos θ := by
  subst hneg
  rcases Int.even_or_odd k with ⟨m, hm⟩ | ⟨m, hm⟩
  · -- k = m + m (even)
    have hmod : k % 2 = 0 := by omega
    have hd : ¬(decide (k % 2 = 1) = true) := by rw [hmod]; decide
    rw [if_neg hd, hm, show (↑(m + m) : ℝ) * π = ↑m * (2 * π) from by push_cast; ring]
    exact cos_sub_int_mul_two_pi θ m
  · -- k = 2*m + 1 (odd)
    have hmod : k % 2 = 1 := by omega
    have hd : decide (k % 2 = 1) = true := by rw [hmod]; decide
    rw [if_pos hd, hm, show (↑(2 * m + 1) : ℝ) * π = ↑m * (2 * π) + π from by push_cast; ring,
        show θ - (↑m * (2 * π) + π) = (θ - π) - ↑m * (2 * π) from by ring]
    rw [cos_sub_int_mul_two_pi (θ - π) m]
    rw [show θ - π = θ + (-1 : ℤ) * π from by push_cast; ring]
    rw [cos_add_int_mul_pi θ (-1)]
    simp

/-- Per-term bridge: Expr.eval of mkRotorTermReduced equals the actual rotorTrace term.
    Combines exp-to-rpow conversion and cosine range reduction. -/
private lemma mkTermReduced_eval_eq (p : ℕ) (hp : 0 < (p : ℝ)) (k : ℤ) (neg : Bool)
    (hneg : neg = decide (k % 2 = 1)) :
    Expr.eval (fun _ => (0 : ℝ)) (mkRotorTermReduced p k neg) =
    Real.log (p : ℝ) * (p : ℝ) ^ (-(1 : ℝ) / 2) *
    Real.cos ((565389 : ℝ) / 40000 * Real.log (p : ℝ)) := by
  subst hneg
  unfold mkRotorTermReduced
  simp only [apply_ite (Expr.eval _), Expr.eval_mul, Expr.eval_log, Expr.eval_const,
    Expr.eval_exp, Expr.eval_neg, Expr.eval_cos, Expr.eval_add, Expr.eval_pi,
    Rat.cast_natCast, Rat.cast_intCast]
  rw [exp_neg_half_log p hp]
  congr 1
  -- Goal: (if decide(k%2=1)=true then -cos(X) else cos(X)) = cos(Y)
  -- X has + -(↑k * π), but signed_cos_eq uses - ↑k * π (sub vs add neg)
  have hscos := signed_cos_eq (((565389 / 40000 : ℚ) : ℝ) * log (↑p)) k
    (decide (k % 2 = 1)) rfl
  simp only [sub_eq_add_neg] at hscos
  rw [hscos]
  congr 1; norm_num

