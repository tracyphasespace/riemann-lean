/-! ## Part 2: LeanCert Expression with Manual Range Reduction -/

/-- One term of the rotorTrace sum as a LeanCert Expr with manual range reduction.
    cos(t·log p) = (-1)^k · cos(t·log p - k·π) where reduced arg ∈ [0, π].
    This avoids the built-in cosComputableReduced which uses crude π bounds. -/
def mkRotorTermReduced (p : ℚ) (k : ℤ) (negSign : Bool) : Expr :=
  let cosArg := .add (.mul (.const (565389/40000)) (.log (.const p)))
                     (.neg (.mul (.const k) .pi))
  let cosTerm := .cos cosArg
  let signedCos := if negSign then .neg cosTerm else cosTerm
  .mul (.mul (.log (.const p))
             (.exp (.neg (.mul (.log (.const p)) (.const (1/2))))))
       signedCos

/-- Per-term interval evaluation using evalIntervalCore1. -/
def termIntervalReduced (p : ℕ) (k : ℤ) (negSign : Bool) (cfg : EvalConfig) : IntervalRat :=
  evalIntervalCore1 (mkRotorTermReduced p k negSign) ⟨0, 0, le_refl _⟩ cfg

